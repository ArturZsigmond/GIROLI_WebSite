# Copy to .env and fill in (or set in hosting dashboard). Do not commit .env.

PORT=8787

# Optional: require ?secret=... or Authorization: Bearer ...
INGEST_SECRET=change-me-long-random-string

# --- Firebase Admin (pick one) ---
# Full service account JSON on one line (escape quotes in some hosts) or use file below via shell.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Or on GCP / local: path to key file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Realtime Database URL (if you use RTDB). Enables RTDB writes to soilDevices/{deviceId}/...
# FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app

# Firestore (default if FIREBASE_DATABASE_URL is unset)
# SOIL_FIREBASE_TARGET=firestore
# SOIL_FIRESTORE_COLLECTION=soilReadings

# To force RTDB when both are configured:
# SOIL_FIREBASE_TARGET=rtdb
