# Copy to .env and fill in (or set in hosting dashboard). Do not commit .env.

PORT=8787

# Optional: require ?secret=... or Authorization: Bearer ...
INGEST_SECRET=

# Main mode:
# - proxy (default): forwards incoming GET to SOIL_UPSTREAM_BASE preserving path+query
# - firebase: writes parsed values directly to Firebase
SOIL_MODE=proxy

# In proxy mode, this is the original target.
SOIL_UPSTREAM_BASE=https://soilproject-fddd0.web.app

# --- Firebase settings (only if SOIL_MODE=firebase) ---
# Full service account JSON on one line (escape quotes in some hosts).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Or on local/GCP: path to key file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

# Firestore target (default):
# SOIL_FIREBASE_TARGET=firestore
# SOIL_FIRESTORE_COLLECTION=soilReadings

# Realtime Database target:
# SOIL_FIREBASE_TARGET=rtdb
# FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app
